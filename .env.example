# Copie para .env e preencha. O .env não vai para o git.
# Variáveis de ambiente definidas no sistema têm prioridade sobre este arquivo.

# Transcrição (Whisper via Groq) — chave em https://console.groq.com/keys
GROQ_API_KEY=
# whisper-large-v3 (mais preciso) ou whisper-large-v3-turbo (mais barato)
GROQ_MODELO_TRANSCRICAO=whisper-large-v3

# Análise da transcrição (OpenRouter) — chave em https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELO_ANALISE=nvidia/nemotron-3.5-super-vl:free
# Modelo que descreve as telas (Fase 2); precisa aceitar imagem e JSON Schema. Vazio = o mesmo da análise.
OPENROUTER_MODELO_VISAO=

# Idioma falado no vídeo (ISO-639-1)
MINUTA_IDIOMA=pt

# Opcional: pasta do ffmpeg.exe/ffprobe.exe. Vazio = procurar no PATH.
FFMPEG_PATH=

# Opcional: glossário para o Whisper acertar a grafia de siglas e nomes (um termo por linha).
# Vazio = usa glossario.txt ao lado deste arquivo, se existir. Modelo em glossario.exemplo.txt.
MINUTA_GLOSSARIO=
